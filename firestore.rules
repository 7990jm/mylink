rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 마이링크 데이터: 누구나 읽기 가능, 주인(Google 로그인)만 수정 가능
    match /sites/{siteId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == "7990jm@gmail.com"
        && request.auth.token.email_verified == true;
    }
    // 그 외 모든 문서는 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
